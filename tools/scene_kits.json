{
  "version": 1,
  "rules": {
    "baseline": "subtle animated text and graphics; a scene kit is a special moment",
    "budget": "at most 1 kit per 4 scenes",
    "no_back_to_back": true,
    "no_same_kit_three_in_row": true,
    "script_direction_wins": "a direction written by the owner can force or ban any kit and is never rewritten",
    "pack_override": "each style pack may set its own budget"
  },
  "kits": {
    "search-chat": {
      "layer_kind": "screen-scene",
      "use_when": [
        "searching online",
        "typing",
        "messaging",
        "chat or DM",
        "buying or selling online",
        "marketplace",
        "hook that shows someone using a computer"
      ],
      "min_scene_seconds": 5.2,
      "steps": {
        "move": "pointer glides to {to: bar|button}",
        "click": "pointer clicks {to: bar|button}, ripple and press",
        "type": "text typed word for word {text}",
        "enter": "bar glows as Enter is pressed",
        "spinner": "loading spinner",
        "bubble": "chat bubble {side: left|right, text}, typing dots first"
      },
      "default_steps": [
        {
          "type": "move",
          "to": "bar"
        },
        {
          "type": "click",
          "to": "bar"
        },
        {
          "type": "type",
          "text": "<search text from the narration>"
        },
        {
          "type": "move",
          "to": "button"
        },
        {
          "type": "click",
          "to": "button"
        },
        {
          "type": "spinner"
        },
        {
          "type": "bubble",
          "side": "right",
          "text": "<buyer line>"
        },
        {
          "type": "bubble",
          "side": "left",
          "text": "<seller reply>"
        }
      ]
    },
    "glass-ui": {
      "layer_kind": "glass-ui",
      "use_when": [
        "music app",
        "now playing",
        "premium app promo",
        "iOS-style interface",
        "tab bar",
        "search button"
      ],
      "min_scene_seconds": 3.5,
      "steps": {
        "pill": "now-playing pill drops in {text, sub}",
        "tab": "tab bar highlight moves to {to: 0-3}",
        "search": "round search button expands and types {text}",
        "hold": "pause {dur}"
      },
      "default_steps": [
        {
          "type": "pill"
        },
        {
          "type": "tab",
          "to": 2
        },
        {
          "type": "search"
        }
      ],
      "how_to_use": "forced only: kit: glass-ui on a scene; never auto-picked yet"
    },
    "terminal-typing": {
      "layer_kind": "terminal-typing",
      "use_when": [
        "coding",
        "command line",
        "developer tools",
        "install or deploy",
        "hacker or tech scene"
      ],
      "min_scene_seconds": 3.5,
      "steps": {
        "cmd": "a command is typed after a $ prompt {text}",
        "out": "an output line appears {text}",
        "hold": "pause {dur}"
      },
      "default_steps": [],
      "how_to_use": "forced only: kit: terminal-typing plus term steps on a scene; no default text, the writer says what the terminal shows"
    },
    "notification-stack": {
      "layer_kind": "notification-stack",
      "use_when": [
        "messages piling up",
        "social media",
        "alerts",
        "app notifications",
        "busy phone"
      ],
      "min_scene_seconds": 3.0,
      "steps": {
        "note": "a banner slides in {title, text}, older ones slide down and fade",
        "hold": "pause {dur}"
      },
      "default_steps": [],
      "how_to_use": "forced only: kit: notification-stack plus stack steps on a scene; no default text, the writer says what each banner shows"
    },
    "counter-graph": {
      "layer_kind": "counter-graph",
      "use_when": [
        "a statistic",
        "growth or decline",
        "numbers over time",
        "percentages",
        "price or score"
      ],
      "min_scene_seconds": 3.0,
      "steps": {
        "counter": "a big number counts to {value} with {label}, {prefix}, {suffix}",
        "line": "a line graph draws through {points}",
        "hold": "pause {dur}"
      },
      "default_steps": [],
      "how_to_use": "forced only: kit: counter-graph plus graph steps on a scene; the numbers come from the writer, never invented"
    },
    "browser-page-load": {
      "layer_kind": "browser-page-load",
      "use_when": [
        "a website",
        "a page loading",
        "opening a link",
        "a landing page",
        "a web app"
      ],
      "min_scene_seconds": 3.5,
      "steps": {
        "url": "the address bar types {text}",
        "load": "the progress bar fills over {dur}",
        "page": "the page content appears {title, text}",
        "hold": "pause {dur}"
      },
      "default_steps": [],
      "how_to_use": "forced only: kit: browser-page-load plus page steps on a scene; the writer says the address and what the page shows"
    },
    "checkout": {
      "layer_kind": "checkout",
      "use_when": [
        "buying something",
        "a payment",
        "an order",
        "subscription",
        "price or cost"
      ],
      "min_scene_seconds": 3.5,
      "steps": {
        "item": "an item row slides in {text, price}",
        "total": "the total row appears {text, price}",
        "pay": "the pay button is pressed {text}",
        "done": "a success check draws {text}",
        "hold": "pause {dur}"
      },
      "default_steps": [],
      "how_to_use": "forced only: kit: checkout plus checkout steps on a scene; every name and price comes from the writer, nothing is added up or invented"
    },
    "alert-glitch": {
      "layer_kind": "alert-glitch",
      "use_when": [
        "a warning",
        "an error",
        "a hack or breach",
        "danger",
        "something going wrong"
      ],
      "min_scene_seconds": 3.0,
      "steps": {
        "alert": "a warning panel appears {title, text}",
        "glitch": "colour-split ghosts, jitter and flicker for {dur}",
        "hold": "pause {dur}"
      },
      "default_steps": [],
      "how_to_use": "forced only: kit: alert-glitch plus alert steps on a scene; the writer says what the alert says"
    }
  },
  "planned_kits": [
    "transfer-progress"
  ]
}