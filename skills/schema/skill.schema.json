{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shorts-studio/skill-manifest@1",
  "title": "Shorts Studio skill manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "category",
    "description",
    "triggers",
    "capabilities",
    "content_file",
    "status",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "formats": {
      "type": "array",
      "items": {
        "enum": [
          "vertical",
          "landscape",
          "square",
          "any"
        ]
      }
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "quality_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "engines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "content_file": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "review",
        "disabled"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "builtin",
            "external",
            "custom"
          ]
        },
        "source": {
          "type": "string"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
